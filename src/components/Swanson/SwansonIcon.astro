---
// Header button that summons Swanson (lives where the terminal icon used to).
// When something has landed on the site in the last few days, Swanson bounces
// and pipes up in a speech bubble; clicking it opens him with "What's new?"
// already asked. Fed by /whats-new.json, judged in the browser, so it goes
// quiet on its own without a rebuild.
---

<div class="swanson-nudge-wrap">
  <button
    id="swanson-toggle"
    class="swanson-toggle p-1 rounded-lg transition-transform hover:scale-110"
    aria-label="Ask Swanson, Stephen's AI alter ego"
    title="Ask Swanson"
  >
    <img
      src="/swanson-avatar.png"
      alt=""
      class="w-7 h-7 rounded-md object-cover"
      style="border: 1px solid var(--color-border);"
    />
  </button>

  <div id="swanson-nudge" class="swanson-nudge" role="status" hidden>
    <button type="button" class="swanson-nudge__ask" id="swanson-nudge-ask"></button>
    <button type="button" class="swanson-nudge__close" id="swanson-nudge-close" aria-label="Dismiss">×</button>
  </div>
</div>

<style>
  .swanson-nudge-wrap { position: relative; display: inline-flex; }

  .swanson-toggle.is-nudging img { animation: swanson-bounce 1.1s cubic-bezier(0.34, 1.56, 0.64, 1) 3; }
  @keyframes swanson-bounce {
    0%, 100% { transform: translateY(0); }
    30%      { transform: translateY(-7px) rotate(-6deg); }
    50%      { transform: translateY(0); }
    70%      { transform: translateY(-3px) rotate(4deg); }
  }

  .swanson-nudge {
    position: absolute;
    top: calc(100% + 0.6rem);
    right: 0;
    z-index: 60;
    display: flex;
    align-items: flex-start;
    gap: 0.25rem;
    width: max-content;
    max-width: min(18rem, calc(100vw - 2rem));
    padding: 0.6rem 0.4rem 0.6rem 0.85rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-medium);
    font-size: 0.85rem;
    line-height: 1.4;
    animation: swanson-nudge-in 0.35s cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: 0.5s;
  }
  .swanson-nudge[hidden] { display: none; }
  /* speech-bubble tail, pointing up at the icon */
  .swanson-nudge::before {
    content: '';
    position: absolute;
    top: -7px;
    right: 0.9rem;
    width: 12px;
    height: 12px;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    transform: rotate(45deg);
  }
  @keyframes swanson-nudge-in {
    from { opacity: 0; transform: translateY(-6px) scale(0.96); }
    to   { opacity: 1; transform: none; }
  }

  .swanson-nudge__ask {
    background: none;
    border: 0;
    padding: 0;
    text-align: left;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
  .swanson-nudge__ask:hover { color: var(--color-accent); }
  .swanson-nudge__close {
    flex-shrink: 0;
    background: none;
    border: 0;
    padding: 0 0.3rem;
    line-height: 1;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    cursor: pointer;
  }
  .swanson-nudge__close:hover { color: var(--color-accent); }

  @media (prefers-reduced-motion: reduce) {
    .swanson-toggle.is-nudging img, .swanson-nudge { animation: none; }
  }
</style>

<script>
  const FRESH_DAYS = 5;
  const SEEN_KEY = 'swanson-nudge-seen';

  // One per visit, chosen at random. He is not asking twice.
  const LINES = [
    'New work has landed. I have read it. You have not. Ask me.',
    'Stephen shipped something. I checked; it was not a clerical error. Ask me what.',
    'There is fresh meat on the site. Ask me, before it goes cold.',
    'Something new arrived this week. I am telling you once. Ask me.',
    'New content. I would call it exciting, but I do not do exciting. Ask me anyway.',
    'Stephen has been busy. I have opinions on it. Ask me.',
  ];

  async function nudge() {
    const toggle = document.getElementById('swanson-toggle');
    const bubble = document.getElementById('swanson-nudge');
    const ask = document.getElementById('swanson-nudge-ask');
    const close = document.getElementById('swanson-nudge-close');
    if (!toggle || !bubble || !ask || !close) return;

    let newest: string | null = null;
    try {
      const res = await fetch('/whats-new.json');
      const data = await res.json();
      const fresh = (data.entries || []).filter(
        (e: { date: string }) => (Date.now() - new Date(e.date).getTime()) / 864e5 <= FRESH_DAYS
      );
      if (!fresh.length) return;
      newest = fresh[0].date;
    } catch {
      return;
    }

    // Dismissed already for this batch of new things? Stay quiet until something newer lands.
    try {
      if (localStorage.getItem(SEEN_KEY) === newest) return;
    } catch {}

    ask.textContent = LINES[Math.floor(Math.random() * LINES.length)];
    bubble.hidden = false;
    toggle.classList.add('is-nudging');

    const dismiss = () => {
      bubble.hidden = true;
      toggle.classList.remove('is-nudging');
      try { localStorage.setItem(SEEN_KEY, newest!); } catch {}
    };

    close.addEventListener('click', dismiss);
    toggle.addEventListener('click', dismiss, { once: true });
    ask.addEventListener('click', () => {
      dismiss();
      toggle.click();
      setTimeout(() => {
        const input = document.getElementById('swanson-input') as HTMLInputElement | null;
        const form = document.getElementById('swanson-form') as HTMLFormElement | null;
        if (!input || !form) return;
        input.value = "What's new?";
        form.requestSubmit();
      }, 400);
    });
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', nudge);
  else nudge();
</script>
