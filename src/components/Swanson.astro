---
// Swanson — Stephen's AI alter ego. A quiet card on the homepage that
// answers questions about the site via the swanson-api worker (worker/),
// falling back to the canned Q&A in public/swanson-qa.json whenever the
// worker is unset, capped or unreachable. Progressive enhancement: with
// JavaScript off, the card degrades to plain links.
const SWANSON_API =
  import.meta.env.PUBLIC_SWANSON_API ?? (import.meta.env.DEV ? 'http://localhost:8787' : '');
---

<section class="max-w-6xl mx-auto">
  <div class="card relative overflow-hidden animate-slide-in-left" style="padding: 1.5rem;">
    <div class="absolute top-0 left-0 ribbon-top-left">
      <span
        style="background: #b45309; color: white;"
        class="px-4 py-2 text-xs font-black uppercase tracking-wider shadow-lg"
      >
        Swanson
      </span>
    </div>

    <div class="flex items-start gap-4 mt-8">
      <img
        src="/swanson-avatar.png"
        alt="Swanson, Stephen's AI alter ego"
        class="w-16 h-16 rounded-xl object-cover flex-shrink-0"
        style="border: 2px solid var(--color-border);"
        loading="lazy"
      />
      <div class="min-w-0 flex-1">
        <h2 style="color: var(--color-text-heading);" class="text-lg font-bold leading-tight">
          Ask Swanson
        </h2>
        <p style="color: var(--color-text-secondary);" class="text-sm leading-relaxed mt-1">
          Stephen's digital alter ego — all his knowledge, none of the bugs. Ask what to read,
          what he's building, or where anything on this site is.
        </p>
        <noscript>
          <p style="color: var(--color-text-muted);" class="text-sm mt-2">
            Swanson needs JavaScript. Without him: <a href="/writing" style="color: var(--color-accent);">writing</a>,
            <a href="/projects" style="color: var(--color-accent);">projects</a>,
            <a href="/now" style="color: var(--color-accent);">now</a>.
          </p>
        </noscript>
      </div>
    </div>

    <div id="swanson-log" class="swanson-log hidden" aria-live="polite"></div>

    <form id="swanson-form" class="flex gap-2 mt-4">
      <input
        id="swanson-input"
        type="text"
        maxlength="500"
        placeholder="e.g. what should I read first?"
        autocomplete="off"
        class="flex-1 rounded-lg px-4 py-2.5 text-sm"
        style="background: var(--color-bg-secondary); border: 1px solid var(--color-border); color: var(--color-text);"
      />
      <button
        type="submit"
        class="rounded-lg px-5 py-2.5 text-sm font-semibold transition-opacity hover:opacity-80"
        style="background: var(--color-accent); color: white;"
      >
        Ask
      </button>
    </form>
    <p style="color: var(--color-text-muted);" class="text-[11px] mt-2">
      Swanson is an AI. He is confident, not infallible — a bit like Stephen.
    </p>
  </div>
</section>

<style is:global>
  .swanson-log {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 24rem;
    overflow-y: auto;
  }
  .swanson-msg {
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }
  .swanson-msg-user {
    background: var(--color-accent);
    color: white;
    align-self: flex-end;
    max-width: 85%;
  }
  .swanson-msg-bot {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    align-self: flex-start;
    max-width: 95%;
  }
  .swanson-msg-bot a {
    color: var(--color-accent);
    text-decoration: underline;
  }
  .swanson-thinking::after {
    content: '…';
    animation: swanson-dots 1.2s steps(4, end) infinite;
  }
  @keyframes swanson-dots {
    0% { content: ''; }
    25% { content: '.'; }
    50% { content: '..'; }
    75% { content: '...'; }
  }
</style>

<script define:vars={{ SWANSON_API }}>
  const form = document.getElementById('swanson-form');
  const input = document.getElementById('swanson-input');
  const log = document.getElementById('swanson-log');
  if (form && input && log) {
    const history = [];
    let canned = null;
    let busy = false;

    async function loadCanned() {
      if (canned) return canned;
      try {
        const res = await fetch('/swanson-qa.json');
        canned = await res.json();
      } catch {
        canned = { qaPairs: [] };
      }
      return canned;
    }

    function similarity(a, b) {
      const wa = a.toLowerCase().split(/\s+/).filter((w) => w.length > 2);
      const wb = b.toLowerCase().split(/\s+/).filter((w) => w.length > 2);
      if (!wa.length || !wb.length) return 0;
      const overlap = wa.filter((w) => wb.includes(w)).length;
      return overlap / Math.max(wa.length, wb.length);
    }

    async function cannedAnswer(question) {
      const qa = await loadCanned();
      let best = null;
      let bestScore = 0;
      for (const pair of qa.qaPairs || []) {
        for (const known of pair.questions) {
          const score = similarity(question, known);
          if (score > bestScore) {
            bestScore = score;
            best = pair;
          }
        }
      }
      if (best && bestScore > 0.5) return best.answer;
      return "The clever half of my brain is offline, so I'll keep it simple: essays live at /writing, projects at /projects, and what Stephen's up to right now is at /now.";
    }

    // Safe rendering: text nodes only, with site paths and URLs linkified.
    function renderBot(el, text) {
      el.textContent = '';
      const parts = text.split(/(https?:\/\/[^\s)]+|\/[a-z0-9][a-z0-9\-/]*)/g);
      for (const part of parts) {
        if (/^(https?:\/\/|\/[a-z0-9])/.test(part)) {
          const a = document.createElement('a');
          a.href = part;
          a.textContent = part;
          if (part.startsWith('http')) {
            a.target = '_blank';
            a.rel = 'noopener';
          }
          el.appendChild(a);
        } else {
          el.appendChild(document.createTextNode(part));
        }
      }
    }

    function addMsg(cls) {
      const el = document.createElement('div');
      el.className = `swanson-msg ${cls}`;
      log.appendChild(el);
      log.classList.remove('hidden');
      log.scrollTop = log.scrollHeight;
      return el;
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const question = input.value.trim();
      if (!question || busy) return;
      busy = true;
      input.value = '';

      addMsg('swanson-msg-user').textContent = question;
      const bot = addMsg('swanson-msg-bot swanson-thinking');
      bot.textContent = 'Swanson is thinking';

      let answer = null;
      if (SWANSON_API) {
        try {
          const controller = new AbortController();
          const timer = setTimeout(() => controller.abort(), 20000);
          const res = await fetch(SWANSON_API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ question, history: history.slice(-6) }),
            signal: controller.signal,
          });
          clearTimeout(timer);
          if (res.ok || res.status === 429) {
            const data = await res.json();
            if (data.answer) answer = data.answer;
          }
        } catch {
          // worker unreachable — fall through to canned
        }
      }
      if (!answer) answer = await cannedAnswer(question);

      bot.classList.remove('swanson-thinking');
      renderBot(bot, answer);
      log.scrollTop = log.scrollHeight;

      history.push({ role: 'user', content: question });
      history.push({ role: 'assistant', content: answer });
      if (history.length > 12) history.splice(0, history.length - 12);
      busy = false;
      input.focus();
    });
  }
</script>
