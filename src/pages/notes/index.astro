---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ListingToolbar from '../../components/ListingToolbar.astro';
import EntryCard from '../../components/EntryCard.astro';
import { markFor } from '../../utils/markFor';

const notes = (await getCollection('notes'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Notes - Stephen McCullough"
  description="Quick notes, snippets, and thoughts"
  wide
>
  <div class="space-y-8">
    <div class="space-y-4">
      <h1 style="color: var(--color-text-heading);" class="text-4xl md:text-5xl font-bold tracking-tight">
        Notes
      </h1>
      <p style="color: var(--color-text-secondary);" class="text-lg md:text-xl leading-relaxed">
        Technical snippets and quick references
      </p>
    </div>

    {notes.length === 0 ? (
      <p style="color: var(--color-text-secondary);">No notes yet. Check back soon!</p>
    ) : (
      <div>
        <ListingToolbar placeholder="Search notes…" searchLabel="Search notes" />

        <ul class="entry-grid entry-grid--compact" id="listing-grid">
          {notes.map((note, i) => (
            <EntryCard
              href={`/notes/${note.id}`}
              title={note.data.title}
              date={note.data.pubDate}
              tags={note.data.tags}
              icon={markFor(note.data.tags)}
              index={i}
            />
          ))}
        </ul>

        <div class="listing-empty" id="listing-empty">
          Nothing matches that. Try a different word, or clear the filters.
        </div>
      </div>
    )}
  </div>

  <script src="../../scripts/listing.ts"></script>
</BaseLayout>
